# Copy to .env (gitignored) and export before running, e.g.:
#   set -a; source .env; set +a; phxbot run --config config.yaml

# --- Hibachi (hibachi.xyz -> gear icon -> API) ---
# The "paper"/0 placeholders are enough for paper mode (market data on both
# venues needs no credentials); replace with real values before going live.
HIBACHI_API_KEY=paper
HIBACHI_ACCOUNT_ID=0
HIBACHI_PRIVATE_KEY=paper

# --- Phoenix (phoenix.trade; account must be onboarded/activated) ---
# base58-encoded Solana keypair of the trader authority wallet
PHOENIX_WALLET_PRIVATE_KEY=
# Solana mainnet RPC endpoint (private endpoint recommended)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
